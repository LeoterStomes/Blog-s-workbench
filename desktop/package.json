{
  "name": "ray-content-workbench-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Ray 内容工作台桌面客户端",
  "author": "Ray",
  "main": "main.mjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.mjs",
    "build:frontend": "npm --prefix ../astro-blog run build",
    "package:win": "npm run build:frontend && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "me.ray.workbench",
    "productName": "Ray Workbench",
    "asar": true,
    "files": [
      "main.mjs",
      "preload.cjs",
      "local-server.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../astro-blog/dist/client",
        "to": "web"
      },
      {
        "from": "../python-backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!logs/**",
          "!.pytest_cache/**"
        ]
      },
      {
        "from": "../python-backend/.env",
        "to": "backend/.env"
      },
      {
        "from": "../ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Ray-Workbench-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ray Workbench",
      "runAfterFinish": true
    }
  }
}
