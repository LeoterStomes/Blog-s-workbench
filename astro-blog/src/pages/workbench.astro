---
import BaseLayout from '@layouts/BaseLayout.astro';
import WorkbenchView from '@components/vue/WorkbenchView.vue';
---

<BaseLayout title="内容工作台" chromeless>
  <WorkbenchView client:only="vue" />
</BaseLayout>

<style is:global>
  body > footer {
    display: none !important;
  }

  body.app-chromeless {
    display: block !important;
    min-height: 100vh;
    background: #eef2f8 !important;
  }

  body.app-chromeless #bg-overlay {
    display: none !important;
  }

  body.app-chromeless .workbench {
    min-height: 100vh;
  }

  body.app-chromeless .workbench-layout {
    height: calc(100vh - clamp(108px, 12vh, 126px));
  }

  @media (max-width: 860px) {
    body.app-chromeless .workbench-layout {
      height: calc(100vh - 84px);
    }
  }

  body:has(.workbench) button[title="AI 助手"],
  body:has(.workbench) button[title="搜索文章 (Ctrl+K)"] {
    display: none !important;
  }
</style>
